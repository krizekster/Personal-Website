---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
---

<BaseLayout title="Ventures — Krize Kster" description="The ventures and product work of Krize Kster.">
  <section class="page-hero">
    <p class="eyebrow">Ventures / 02</p>
    <h1 data-parallax="0.04">Different directions. One standard of care.</h1>
    <p>From complex systems to calm consumer tools, each venture is a way of making technology more useful in the real world.</p>
  </section>

  <section id="krizek" class="border-y border-line bg-[#31433a] text-paper">
    <div class="section-wrap">
      <div class="grid gap-10 lg:grid-cols-[1fr_.8fr] lg:items-end">
        <div>
          <p class="eyebrow text-mist">01 / Science &amp; Telemetry</p>
          <h2 data-parallax="0.05" class="mt-4 text-[clamp(5rem,13vw,13rem)] font-extrabold leading-[.7] tracking-[-.12em] uppercase">KRI<br />ZEK</h2>
        </div>
        <div>
          <p class="text-xl leading-relaxed tracking-[-.04em] text-mist">Gamers, researchers and scientists working on the real-world benefits of gaming through data, AI and scientific insight. Runs a gaming industry feed channel with hundreds of published articles.</p>
          <a href="https://krizek.tech" target="_blank" rel="noopener noreferrer" class="button button-light mt-8 border-paper/40 bg-transparent text-paper hover:bg-paper hover:text-ink" data-magnetic data-magnetic-strength="0.4">
            <span class="magnetic-text">Visit krizek.tech <span aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
      <div class="mt-16 grid gap-5 md:grid-cols-2">
        <div class="rounded-[1.35rem] border border-paper/20 p-7">
          <p class="eyebrow text-mist">Corporate Structure</p>
          <h3 class="mt-5 text-3xl font-bold leading-[.95] tracking-[-.07em]">Dual-entity operation.</h3>
          <p class="mt-5 text-sm leading-relaxed text-mist">Operating across KRI ZEK LLC (Delaware) and Krizek India Private Limited (Jaipur).</p>
        </div>
        <div class="rounded-[1.35rem] border border-paper/20 p-7">
          <p class="eyebrow text-mist">Measurement Layer</p>
          <h3 class="mt-5 text-3xl font-bold leading-[.95] tracking-[-.07em]">tGiX™ Algorithm</h3>
          <p class="mt-5 text-sm leading-relaxed text-mist">Non-intrusive interaction telemetry converting raw play into the 8-vector Altered Quotient (0.00 to 100.00).</p>
        </div>
      </div>
    </div>
  </section>

  <section id="altered-brilliance" class="section-wrap scroll-mt-6">
    <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-start">
      <div class="rounded-[2rem] bg-[#d7e0ca] p-8 sm:p-12">
        <p class="eyebrow">02 / Consumer Product</p>
        <h2 data-parallax="0.04" class="mt-8 text-[clamp(4.2rem,8vw,8rem)] font-extrabold leading-[.78] tracking-[-.11em]">Altered<br />Brilliance</h2>
      </div>
      <div class="lg:pt-12">
        <p class="eyebrow">Gamified Productivity &amp; Wellness</p>
        <p class="mt-5 max-w-2xl text-[clamp(1.35rem,2.5vw,2rem)] leading-[1.36] tracking-[-.045em] text-ink-soft">Gamified productivity and wellness, powered by tGiX™. Focus sessions, cognitive scoring, and adaptive progression. Live on the Google Play Store.</p>
        <div class="mt-8">
          <a href="https://play.google.com/store/apps/details?id=tech.krizek.alteredbrilliance" target="_blank" rel="noopener noreferrer" class="button button-dark" data-magnetic data-magnetic-strength="0.35">
            <span class="magnetic-text">Get on Google Play Store ↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Hardware & Model Projects Grid -->
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <Card title="WOWCube Consoles" tag="03 / Hardware Game Design" subtitle="24-screen physical console" accent="green">
        <p>Two games deployed on the WOWCube console, a 24-screen physical cube device. Novel-hardware game design executed from initial concept to physical store deployment.</p>
      </Card>
      <Card title="Codename TGX-1" tag="04 / Metacognitive Model" subtitle="Fine-tuned SLM layer" accent="blue">
        <p>A fine-tuned small language model acting as a metacognitive layer over tGiX™ telemetry. Interprets quantitative profiles into behavioral archetypes and adaptive interventions. In active development.</p>
      </Card>
    </div>
  </section>

  <section id="selected-private-workspaces" class="border-t border-line bg-paper-deep/40">
    <div class="section-wrap">
      <div class="grid gap-8 lg:grid-cols-[.65fr_1fr] lg:items-end">
        <div>
          <p class="eyebrow">05 / Selected private workspaces</p>
          <h2 data-parallax="0.025" class="section-heading mt-3">Work that stays intentionally behind the scenes.</h2>
        </div>
        <p class="max-w-2xl text-sm leading-relaxed text-ink-soft">A public-facing record of ongoing product work. These notes focus on the problem each workspace is designed to address and the value it aims to create; internal assets, implementation details, data, and unreleased capabilities remain private.</p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        <Card title="Codename TheLastOfUs" tag="05 / Interactive Tools" subtitle="2D creation workspace" accent="green">
          <p>A private 2D creation workspace focused on helping ideas move from early concept to playable, testable experiences with greater clarity.</p>
        </Card>
        <Card title="Codename Deacon" tag="06 / Developer Tools" subtitle="Game team workspace" accent="steel">
          <p>An AI-assisted game-development workspace designed to improve planning, coordination, and iteration across a game project’s lifecycle.</p>
        </Card>
        <Card title="Codename Joel" tag="07 / Player Experience" subtitle="Gaming companion" accent="blue">
          <p>A player-focused companion workspace exploring more reflective, balanced ways to understand play and carry its positive habits into everyday routines.</p>
        </Card>
        <Card title="Codename Kratos" tag="08 / Personal Systems" subtitle="Productivity planner" accent="steel">
          <p>A local-first productivity planner designed to turn priorities, focus, and day-to-day commitments into a calmer, more intentional routine.</p>
        </Card>
        <Card title="Codename Stranding" tag="09 / Personal Wellbeing" subtitle="Wellbeing planner" accent="green">
          <p>A privacy-conscious wellbeing workspace for organizing personal routines, everyday habits, and self-care without treating private information as a product feature.</p>
        </Card>
        <Card title="Codename TGX1" tag="10 / Applied Intelligence" subtitle="Research workspace" accent="blue">
          <p>A private research and intelligence workspace exploring context-aware tools for interactive experiences. Only the intended impact is public; the underlying methods, data, and models remain private.</p>
        </Card>
      </div>
    </div>
  </section>
</BaseLayout>
