---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedSearch from '../../components/FeedSearch.astro';
import { getCollection } from 'astro:content';

const rawArticles = await getCollection('feed');
const sortedArticles = rawArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const articlesIndexData = sortedArticles.map((article) => ({
  slug: article.id,
  title: article.data.title,
  description: article.data.description,
  pubDate: formatDate(article.data.pubDate),
  category: article.data.category,
  tags: article.data.tags,
  telemetryCode: article.data.telemetryCode,
  readTime: article.data.readTime
}));
---

<BaseLayout title="Writing — Krize Kster" description="Notes on software, products, games, and systems by Krize Kster.">
  <section class="page-hero">
    <p class="eyebrow">Writing / 03</p>
    <h1 data-parallax="0.04">Notes on making better things.</h1>
    <p>Thoughts on engineering, product systems, games, and the creative work that happens when you take the details seriously.</p>
  </section>
  <section class="border-y border-line bg-[#e4e9df]">
    <div class="section-wrap pt-10">
      <FeedSearch articles={articlesIndexData} />
    </div>
  </section>
</BaseLayout>
