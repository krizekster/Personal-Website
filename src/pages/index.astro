---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingLoader from '../components/LandingLoader.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('feed');
const latestArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredResearch = (await getCollection('research'))
  .filter((r) => r.data.doi)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title="Krize Kster — Engineer, Founder & Writer"
  description="The personal website of Krize Kster: thoughtful digital products, ventures, and writing."
>
  <LandingLoader slot="overlay" />
  <section class="landing-hero relative mx-auto min-h-[min(53rem,calc(100svh-5.7rem))] max-w-[1560px] overflow-hidden rounded-[2rem] bg-paper-deep px-5 pb-8 pt-5 sm:px-8 lg:min-h-[46rem]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_52%_40%,rgba(255,255,255,.85),transparent_24rem),linear-gradient(135deg,#f7f7f1_0%,#e4e9df_100%)]"></div>
    <div data-parallax="-0.1" class="absolute left-[6%] top-[18%] h-36 w-36 rounded-full border border-sage/20 sm:h-52 sm:w-52"></div>
    <div data-parallax="0.13" class="absolute bottom-[12%] right-[8%] h-20 w-20 rounded-full bg-[#cdd8c7] opacity-70 sm:h-36 sm:w-36"></div>

    <div class="relative z-10 flex h-full min-h-[inherit] flex-col justify-between">
      <div class="flex items-start justify-between gap-4">
        <p class="eyebrow max-w-[13rem] leading-relaxed">Independent engineer<br class="hidden sm:block" /> &amp; product thinker</p>
        <p class="hidden max-w-[13rem] text-right text-sm leading-relaxed text-ink-soft lg:block">Building enduring digital products through clarity, curiosity, and a systems point of view.</p>
      </div>

      <div class="pointer-events-none absolute inset-x-0 bottom-[15%] top-[1%] z-0 flex flex-col justify-center font-display text-[clamp(4.65rem,14.2vw,14.8rem)] font-extrabold leading-[.69] tracking-[-.12em] text-sage-deep sm:bottom-[14%] sm:top-0 sm:leading-[.73]" aria-hidden="true">
        <span class="pl-[.02em]">KRIZE</span>
        <span class="self-end pr-[.03em]">KSTER</span>
      </div>

      <div class="pointer-events-none absolute inset-x-0 bottom-44 z-10 flex h-[88%] justify-center sm:bottom-auto sm:top-[4%] sm:h-[85%]">
        <img
          data-parallax="-0.03"
          src="/krize-kster-portrait-960.webp"
          srcset="/krize-kster-portrait-960.webp 960w, /krize-kster-portrait-1920.webp 1920w"
          sizes="(max-width: 639px) 135vw, (max-width: 1200px) 70vw, 840px"
          width="1920"
          height="1278"
          fetchpriority="high"
          decoding="async"
          alt=""
          class="mx-auto h-auto w-[135vw] max-w-none self-end object-contain object-bottom sm:w-[min(70vw,840px)]"
        />
      </div>

      <div class="relative z-10 mt-auto grid grid-cols-1 items-end gap-5 sm:grid-cols-2">
        <p class="max-w-[22rem] text-sm leading-relaxed text-ink sm:text-base">I wrote the book on why games change us, published the research behind it, and built tGiX™, the algorithm that turns play telemetry into a measurable cognitive index.</p>
        <div class="flex items-end justify-between gap-4 sm:justify-self-end">
          <a href="#about" class="button button-dark" data-magnetic data-magnetic-strength="0.35"><span class="magnetic-text">Explore the work <span aria-hidden="true">↓</span></span></a>
          <span class="hidden font-mono text-[.63rem] uppercase tracking-[.1em] text-ink-soft sm:block">Scroll slowly</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Kinetic Marquee Banner -->
  <div class="kinetic-marquee">
    <div class="marquee-track">
      <div class="marquee-item">
        <span>Krize Kster</span>
        <span class="marquee-dot"></span>
        <span>Krishna Soni</span>
        <span class="marquee-dot"></span>
        <span>tGiX™ Algorithm</span>
        <span class="marquee-dot"></span>
        <span>KRI ZEK</span>
        <span class="marquee-dot"></span>
        <span>Altered Brilliance</span>
        <span class="marquee-dot"></span>
      </div>
      <div class="marquee-item">
        <span>Krize Kster</span>
        <span class="marquee-dot"></span>
        <span>Krishna Soni</span>
        <span class="marquee-dot"></span>
        <span>tGiX™ Algorithm</span>
        <span class="marquee-dot"></span>
        <span>KRI ZEK</span>
        <span class="marquee-dot"></span>
        <span>Altered Brilliance</span>
        <span class="marquee-dot"></span>
      </div>
    </div>
  </div>

  <section id="about" class="section-wrap grid gap-10 lg:grid-cols-[.55fr_1fr] lg:gap-20">
    <div>
      <p class="eyebrow">01 / About</p>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-soft">A considered approach to technology: make it useful, make it clear, and make it last.</p>
    </div>
    <div>
      <h1 data-parallax="0.028" class="section-heading">The through-line is thoughtful systems.</h1>
      <p class="display-copy mt-8 max-w-2xl">Years spent at the intersection of gaming, neuroscience, and AI: the book, the peer-reviewed research, and the algorithm that turns gameplay into a proprietary cognitive dataset.</p>
      <a href="/about/" class="text-link mt-8" data-page-transition data-transition-label="About" data-magnetic data-magnetic-strength="0.3"><span class="magnetic-text">More about the approach <span aria-hidden="true">↗</span></span></a>
    </div>
  </section>

  <!-- Selected Research Block -->
  <section id="research" class="border-t border-line bg-paper-deep/40 py-16">
    <div class="section-wrap">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">02 / Selected Research</p>
          <h2 data-parallax="0.025" class="section-heading mt-3">Quantifying human potential through play.</h2>
        </div>
        <a href="/research/" class="text-link shrink-0" data-page-transition data-transition-label="Research" data-magnetic data-magnetic-strength="0.3"><span class="magnetic-text">Explore all research <span aria-hidden="true">↗</span></span></a>
      </div>

      <div class="mt-10 space-y-4">
        {featuredResearch.map((item, idx) => (
          <a
            href={`https://doi.org/${item.data.doi}`}
            target="_blank"
            rel="noopener noreferrer"
            class="editorial-card group block transition-all hover:border-sage-deep/40"
            data-preview-image="/krize-kster-portrait-960.webp"
            data-preview-label="DOI"
          >
            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
              <div>
                <div class="flex items-center gap-3 font-mono text-[.66rem] uppercase tracking-wider text-ink-soft">
                  <span class="font-bold text-sage-deep">0{idx + 1}</span>
                  <span>{item.data.venue} {item.data.venueDetail && `— ${item.data.venueDetail}`}</span>
                </div>
                <h3 class="mt-2 text-xl font-bold tracking-tight text-ink group-hover:text-sage-deep sm:text-2xl">{item.data.title}</h3>
                <p class="mt-1 text-sm text-ink-soft">{item.data.contribution}</p>
              </div>
              <span class="button button-dark shrink-0" data-magnetic data-magnetic-strength="0.3">
                <span class="magnetic-text">DOI ↗</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="ventures" class="border-y border-line bg-[#e4e9df]">
    <div class="section-wrap">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">02 / Selected ventures</p>
          <h2 data-parallax="0.025" class="section-heading mt-3">Building in two directions.</h2>
        </div>
        <a href="/ventures/" class="text-link shrink-0" data-page-transition data-transition-label="Ventures" data-magnetic data-magnetic-strength="0.3"><span class="magnetic-text">See all ventures <span aria-hidden="true">↗</span></span></a>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <article class="project-card bg-[#31433a] text-paper group" data-preview-image="/krize-kster-portrait-960.webp" data-preview-label="Explore">
          <div>
            <p class="eyebrow text-mist">01 / Enterprise</p>
            <h3 class="mt-5 text-[clamp(3rem,5vw,5.6rem)] font-extrabold leading-[.82] tracking-[-.09em]">KRI<br />ZEK</h3>
          </div>
          <div class="max-w-sm">
            <p class="text-base leading-relaxed text-mist">Technology ventures and systems work for organisations with complex, high-stakes problems.</p>
            <a href="/ventures/#krizek" class="text-link mt-6" data-page-transition data-transition-label="Ventures" data-magnetic data-magnetic-strength="0.35"><span class="magnetic-text">Explore KRI ZEK <span aria-hidden="true">↗</span></span></a>
          </div>
        </article>
        <article class="project-card bg-[#f8f8f2] text-ink group" data-preview-image="/krize-kster-portrait-960.webp" data-preview-label="Explore">
          <div>
            <p class="eyebrow">02 / Consumer products</p>
            <h3 class="mt-5 text-[clamp(3rem,5vw,5.6rem)] font-extrabold leading-[.82] tracking-[-.09em]">Altered<br />Brilliance</h3>
          </div>
          <div class="max-w-sm">
            <p class="text-base leading-relaxed text-ink-soft">Mobile-first tools shaped around focus, strong interaction design, and less digital clutter.</p>
            <a href="/ventures/#altered-brilliance" class="text-link mt-6" data-page-transition data-transition-label="Ventures" data-magnetic data-magnetic-strength="0.35"><span class="magnetic-text">Explore Altered Brilliance <span aria-hidden="true">↗</span></span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="writing" class="section-wrap">
    <div class="grid gap-8 md:grid-cols-[.65fr_1fr] md:gap-20">
      <div>
        <p class="eyebrow">03 / Notes &amp; writing</p>
        <h2 data-parallax="0.03" class="section-heading mt-3">Things worth thinking through.</h2>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-soft">Notes on building software, systems, products, games, and the wider ideas behind them.</p>
        <a href="/feed/" class="button button-dark mt-8" data-page-transition data-transition-label="Writing" data-magnetic data-magnetic-strength="0.35"><span class="magnetic-text">Read the journal <span aria-hidden="true">↗</span></span></a>
      </div>
      <div>
        {latestArticles.map((article, index) => (
          <article class="editorial-card group" data-preview-image="/krize-kster-portrait-960.webp" data-preview-label="Read">
            <div class="flex justify-between gap-4 font-mono text-[.64rem] uppercase tracking-[.08em] text-ink-soft">
              <span>0{index + 1} / {article.data.category}</span>
              <span>{article.data.readTime}</span>
            </div>
            <h3 class="mt-8 max-w-xl text-[clamp(1.7rem,3.2vw,3rem)] font-bold leading-[.96] tracking-[-.07em]">{article.data.title}</h3>
            <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-soft">{article.data.description}</p>
            <a href={`/feed/${article.id}/`} class="text-link mt-7" data-page-transition data-transition-label="Writing" data-magnetic data-magnetic-strength="0.3"><span class="magnetic-text">Read note <span aria-hidden="true">↗</span></span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
