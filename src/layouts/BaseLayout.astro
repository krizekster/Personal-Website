---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NavDrawer from '../components/NavDrawer.astro';
import CookieModal from '../components/CookieModal.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Krize Kster — Engineer, Founder & Writer',
  description = 'The personal website of Krize Kster: thoughtful digital products, ventures, and writing.',
  ogType = 'website'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/krize-kster-social.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f5ef" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Krize Kster" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Krize Kster" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Krize Kster',
      url: Astro.site,
      description: 'The personal website of Krize Kster: thoughtful digital products, ventures, and writing.',
      inLanguage: 'en'
    })} />
    <slot name="head" />
  </head>
  <body>
    <slot name="overlay" />

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="site-shell" id="top">
      <Header />
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Floating Magnetic Navigation Badge / Drawer Trigger -->
    <button type="button" class="floating-menu-badge cursor-pointer border-none" data-drawer-trigger data-magnetic data-magnetic-strength="0.45" aria-controls="nav-drawer" aria-expanded="false" aria-label="Toggle navigation menu">
      <span class="magnetic-text">Menu</span>
    </button>

    <!-- Overlay Navigation Drawer -->
    <NavDrawer />

    <!-- Cookie Preferences Modal -->
    <CookieModal />

    <!-- Curved handoff shown between internal menu pages -->
    <div id="page-transition" class="page-transition-overlay" aria-hidden="true">
      <p class="page-transition-overlay__label" aria-live="polite"></p>
    </div>

    <script>
      import { initSnellenbergEffects } from '../scripts/snellenberg-effects';

      // Internal handoffs must start at the page header. Otherwise a browser
      // can retain a prior route's scroll offset and show a short route's
      // footer as though it were the first section.
      if ('scrollRestoration' in window.history) {
        window.history.scrollRestoration = 'manual';
      }
      if (!window.location.hash) {
        window.scrollTo(0, 0);
      }

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      initSnellenbergEffects();

      if (!reducedMotion) {
        const parallaxLayers = [...document.querySelectorAll('[data-parallax]')];
        let framePending = false;

        const updateParallax = () => {
          const viewportCenter = window.innerHeight / 2;
          parallaxLayers.forEach((layer) => {
            const speed = Number(layer.getAttribute('data-parallax')) || 0;
            const bounds = layer.getBoundingClientRect();
            const distance = viewportCenter - (bounds.top + bounds.height / 2);
            const offset = Math.max(-72, Math.min(72, distance * speed));
            (layer as HTMLElement).style.setProperty('--parallax-offset', `${Math.round(offset)}px`);
          });
          framePending = false;
        };

        const requestParallaxUpdate = () => {
          if (!framePending) {
            framePending = true;
            window.requestAnimationFrame(updateParallax);
          }
        };

        updateParallax();
        window.addEventListener('scroll', requestParallaxUpdate, { passive: true });
        window.addEventListener('resize', requestParallaxUpdate);
      }
    </script>
  </body>
</html>
