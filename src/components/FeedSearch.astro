---
interface ArticleData {
  slug: string;
  title: string;
  description: string;
  pubDate: string;
  category: string;
  tags: string[];
  telemetryCode: string;
  readTime: string;
}

interface Props { articles: ArticleData[]; }
const { articles } = Astro.props;
const serializedIndex = JSON.stringify(articles);
const categories = ['ALL', 'Engineering', 'Philosophy', 'Gaming', 'Ventures'];
---

<div id="search-container">
  <div class="flex flex-col justify-between gap-5 border-b border-line pb-6 lg:flex-row lg:items-center">
    <label class="relative block w-full lg:max-w-md" for="search-input">
      <span class="sr-only">Search writing</span>
      <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-ink-soft" aria-hidden="true">⌕</span>
      <input id="search-input" type="search" placeholder="Search the notes" class="w-full rounded-full border border-line bg-paper px-10 py-3 text-sm outline-none placeholder:text-ink-soft focus:border-ink" />
    </label>
    <div class="flex flex-wrap gap-2" aria-label="Filter writing by topic">
      {categories.map((category) => (
        <button data-category={category} class={`filter-btn rounded-full border border-line bg-paper px-3 py-2 font-mono text-[.64rem] uppercase tracking-[.07em] transition-colors hover:border-ink ${category === 'ALL' ? 'active' : ''}`}>
          {category}
        </button>
      ))}
    </div>
  </div>

  <div class="flex justify-between py-4 font-mono text-[.64rem] uppercase tracking-[.08em] text-ink-soft">
    <span><span id="results-count" class="font-bold text-ink">{articles.length}</span> notes</span>
    <span>Selected ideas</span>
  </div>

  <div id="articles-list" class="border-t border-line">
    {articles.map((item, index) => (
      <a href={`/feed/${item.slug}/`} class="group grid gap-4 border-b border-line py-7 transition-colors hover:bg-paper/60 sm:grid-cols-[6rem_1fr_auto] sm:items-start sm:px-5" data-page-transition data-transition-label="Writing">
        <span class="font-mono text-[.64rem] uppercase tracking-[.08em] text-ink-soft">0{index + 1} / {item.pubDate}</span>
        <span>
          <span class="font-mono text-[.64rem] uppercase tracking-[.08em] text-sage-deep">{item.category}</span>
          <span class="mt-3 block text-[clamp(1.55rem,3vw,2.55rem)] font-bold leading-[.97] tracking-[-.065em] group-hover:text-sage-deep">{item.title}</span>
          <span class="mt-3 block max-w-2xl text-sm leading-relaxed text-ink-soft">{item.description}</span>
        </span>
        <span class="font-mono text-[.64rem] uppercase tracking-[.08em] text-ink-soft sm:pt-1">{item.readTime} ↗</span>
      </a>
    ))}
  </div>
</div>

<script is:inline define:vars={{ serializedIndex }}>
  const localIndex = JSON.parse(serializedIndex);
  let currentCategory = 'ALL';
  let searchQuery = '';

  const searchInput = document.getElementById('search-input');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const list = document.getElementById('articles-list');
  const resultsCount = document.getElementById('results-count');

  const escapeHtml = (value) => value.replace(/[&<>"']/g, (character) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
  }[character]));

  const renderArticles = () => {
    const filtered = localIndex.filter((article) => {
      const query = searchQuery.toLowerCase();
      const matchesCategory = currentCategory === 'ALL' || article.category === currentCategory;
      const matchesQuery = article.title.toLowerCase().includes(query)
        || article.description.toLowerCase().includes(query)
        || article.tags.some((tag) => tag.toLowerCase().includes(query));
      return matchesCategory && matchesQuery;
    });

    resultsCount.textContent = filtered.length;
    if (!filtered.length) {
      list.innerHTML = '<p class="py-12 text-center text-sm text-ink-soft">No notes match that search.</p>';
      return;
    }

    list.innerHTML = filtered.map((article, index) => `
      <a href="/feed/${encodeURIComponent(article.slug)}/" class="group grid gap-4 border-b border-line py-7 transition-colors hover:bg-paper/60 sm:grid-cols-[6rem_1fr_auto] sm:items-start sm:px-5" data-page-transition data-transition-label="Writing">
        <span class="font-mono text-[.64rem] uppercase tracking-[.08em] text-ink-soft">0${index + 1} / ${escapeHtml(article.pubDate)}</span>
        <span>
          <span class="font-mono text-[.64rem] uppercase tracking-[.08em] text-sage-deep">${escapeHtml(article.category)}</span>
          <span class="mt-3 block text-[clamp(1.55rem,3vw,2.55rem)] font-bold leading-[.97] tracking-[-.065em] group-hover:text-sage-deep">${escapeHtml(article.title)}</span>
          <span class="mt-3 block max-w-2xl text-sm leading-relaxed text-ink-soft">${escapeHtml(article.description)}</span>
        </span>
        <span class="font-mono text-[.64rem] uppercase tracking-[.08em] text-ink-soft sm:pt-1">${escapeHtml(article.readTime)} ↗</span>
      </a>
    `).join('');
  };

  searchInput?.addEventListener('input', (event) => {
    searchQuery = event.target.value;
    renderArticles();
  });

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentCategory = button.getAttribute('data-category') || 'ALL';
      filterButtons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
      renderArticles();
    });
  });
</script>
