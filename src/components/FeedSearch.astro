---
interface ArticleData {
  slug: string;
  title: string;
  description: string;
  pubDate: string; // Will be formatted YYYY.MM.DD
  category: string;
  tags: string[];
  telemetryCode: string;
  readTime: string;
}

interface Props {
  articles: ArticleData[];
}

const { articles } = Astro.props;

// Serialize articles index for the client browser
const serializedIndex = JSON.stringify(articles);
---

<div class="space-y-6" id="search-container">
  
  <!-- Search & Category Filters Row -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center bg-black border border-border-console p-4 relative">
    <!-- Tactile corner ticks -->
    <span class="absolute top-[-1px] left-[-1px] w-1.5 h-1.5 bg-border-console"></span>
    <span class="absolute top-[-1px] right-[-1px] w-1.5 h-1.5 bg-border-console"></span>
    <span class="absolute bottom-[-1px] left-[-1px] w-1.5 h-1.5 bg-border-console"></span>
    <span class="absolute bottom-[-1px] right-[-1px] w-1.5 h-1.5 bg-border-console"></span>

    <!-- Search Input -->
    <div class="lg:col-span-4">
      <label for="search-input" class="sr-only">Search Archive</label>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Query memory index..." 
        class="w-full bg-bg-obsidian border border-border-console px-4 py-2 text-xs font-mono text-zinc-200 placeholder-zinc-700 focus:border-accent-terminal focus:outline-none transition-all"
      />
    </div>

    <!-- Category Filter Selector Buttons -->
    <div class="lg:col-span-8 flex flex-wrap gap-2 items-center justify-start lg:justify-end">
      <span class="text-[9px] font-mono text-zinc-500 mr-2 tracking-widest">FILTER_NODES:</span>
      <button data-category="ALL" class="filter-btn active px-3 py-1.5 border border-accent-terminal bg-accent-terminal/10 text-accent-terminal font-mono text-[9px] tracking-widest cursor-pointer select-none">
        ALL
      </button>
      <button data-category="Engineering" class="filter-btn px-3 py-1.5 border border-border-console bg-black text-zinc-400 font-mono text-[9px] tracking-widest hover:border-zinc-600 cursor-pointer select-none">
        ENGINEERING
      </button>
      <button data-category="Philosophy" class="filter-btn px-3 py-1.5 border border-border-console bg-black text-zinc-400 font-mono text-[9px] tracking-widest hover:border-zinc-600 cursor-pointer select-none">
        PHILOSOPHY
      </button>
      <button data-category="Gaming" class="filter-btn px-3 py-1.5 border border-border-console bg-black text-zinc-400 font-mono text-[9px] tracking-widest hover:border-zinc-600 cursor-pointer select-none">
        GAMING
      </button>
      <button data-category="Ventures" class="filter-btn px-3 py-1.5 border border-border-console bg-black text-zinc-400 font-mono text-[9px] tracking-widest hover:border-zinc-600 cursor-pointer select-none">
        VENTURES
      </button>
    </div>
  </div>

  <!-- Dynamic Search Telemetry Output Line -->
  <div class="w-full flex justify-between items-center text-[9px] font-mono text-zinc-600 px-2 uppercase tracking-widest">
    <div>
      <span>MATCHES: </span>
      <span id="results-count" class="text-white font-bold">{articles.length}</span>
      <span> / {articles.length} LOGS SECURED</span>
    </div>
    <span class="text-zinc-700">// MEMORY_INDEX_READY</span>
  </div>

  <!-- High-Density Single-Line Tabular Dossier Directory -->
  <div class="w-full border border-border-console bg-black/25 overflow-x-auto relative">
    <span class="absolute top-[-1px] left-[-1px] w-1.5 h-1.5 bg-border-console"></span>
    <span class="absolute top-[-1px] right-[-1px] w-1.5 h-1.5 bg-border-console"></span>
    <span class="absolute bottom-[-1px] left-[-1px] w-1.5 h-1.5 bg-border-console"></span>
    <span class="absolute bottom-[-1px] right-[-1px] w-1.5 h-1.5 bg-border-console"></span>

    <table class="w-full text-left border-collapse font-mono text-xs">
      <thead>
        <tr class="border-b border-border-console bg-black/60 text-[9px] tracking-widest text-zinc-500 uppercase">
          <th class="p-4 w-32 border-r border-border-console font-bold">ID // SLUG</th>
          <th class="p-4 border-r border-border-console font-bold">LOG RECORD TITLE</th>
          <th class="p-4 w-36 border-r border-border-console font-bold">SECTOR</th>
          <th class="p-4 w-36 text-right font-bold">DATE ARCHIVED</th>
        </tr>
      </thead>
      <tbody id="articles-table-body">
        {articles.map((item, index) => {
          const counter = String(index + 1).padStart(3, '0');
          return (
            <tr class="border-b border-border-console last:border-none hover:bg-zinc-950/40 transition-colors group">
              <td class="p-4 text-zinc-500 font-bold border-r border-border-console">
                [{counter} // {item.telemetryCode}]
              </td>
              <td class="p-4 border-r border-border-console">
                <a href={`/feed/${item.slug}`} class="text-white group-hover:text-accent-terminal transition-colors flex items-center gap-2">
                  <span>>></span>
                  <span class="font-sans font-bold hover:underline">{item.title}</span>
                </a>
              </td>
              <td class="p-4 border-r border-border-console">
                <span class={`text-[10px] tracking-widest ${
                  item.category === 'Engineering' ? 'text-accent-blue' :
                  item.category === 'Ventures' ? 'text-emerald-500' : 'text-zinc-500'
                }`}>
                  [{item.category.toUpperCase()}]
                </span>
              </td>
              <td class="p-4 text-right text-zinc-400 tracking-wider font-semibold">
                {item.pubDate}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<!-- Progressive Enhancement Table Script Block -->
<script is:inline define:vars={{ serializedIndex }}>
  const localIndex = JSON.parse(serializedIndex);
  
  let currentCategory = 'ALL';
  let searchQuery = '';

  const searchInput = document.getElementById('search-input');
  const filterButtons = document.querySelectorAll('.filter-btn');
  const tableBody = document.getElementById('articles-table-body');
  const resultsCount = document.getElementById('results-count');

  function runSearch() {
    const filtered = localIndex.filter(article => {
      const matchesCategory = currentCategory === 'ALL' || article.category === currentCategory;
      const query = searchQuery.toLowerCase();
      const matchesSearch = article.title.toLowerCase().includes(query) || 
                            article.description.toLowerCase().includes(query) || 
                            article.tags.some(tag => tag.toLowerCase().includes(query));
      
      return matchesCategory && matchesSearch;
    });

    tableBody.innerHTML = '';
    
    if (filtered.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="4" class="p-12 text-center text-zinc-500 text-[10px]">
            // NO_DOSSIER_RECORDS_FOUND_FOR_QUERY
          </td>
        </tr>
      `;
    } else {
      filtered.forEach((article, index) => {
        const counter = String(index + 1).padStart(3, '0');
        const catClass = article.category === 'Engineering' ? 'text-accent-blue' :
                         article.category === 'Ventures' ? 'text-emerald-500' : 'text-zinc-500';
        
        const row = document.createElement('tr');
        row.className = "border-b border-border-console last:border-none hover:bg-zinc-950/40 transition-colors group";
        row.innerHTML = `
          <td class="p-4 text-zinc-500 font-bold border-r border-border-console">
            [${counter} // ${article.telemetryCode}]
          </td>
          <td class="p-4 border-r border-border-console">
            <a href="/feed/${article.slug}" class="text-white group-hover:text-accent-terminal transition-colors flex items-center gap-2">
              <span>>></span>
              <span class="font-sans font-bold hover:underline">${article.title}</span>
            </a>
          </td>
          <td class="p-4 border-r border-border-console">
            <span class="text-[10px] tracking-widest ${catClass}">
              [${article.category.toUpperCase()}]
            </span>
          </td>
          <td class="p-4 text-right text-zinc-400 tracking-wider font-semibold">
            ${article.pubDate}
          </td>
        `;
        tableBody.appendChild(row);
      });
    }

    resultsCount.textContent = filtered.length;
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      runSearch();
    });
  }

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('active', 'border-accent-terminal', 'bg-accent-terminal/10', 'text-accent-terminal');
        b.classList.add('border-border-console', 'bg-black', 'text-zinc-400');
      });

      btn.classList.add('active', 'border-accent-terminal', 'bg-accent-terminal/10', 'text-accent-terminal');
      btn.classList.remove('border-border-console', 'bg-black', 'text-zinc-400');

      currentCategory = btn.getAttribute('data-category');
      runSearch();
    });
  });

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (searchInput) searchInput.focus();
    }
  });
</script>
