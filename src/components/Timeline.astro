      const isEven = index % 2 === 0;
      return (
        <div class={`relative flex flex-col sm:flex-row items-start ${isEven ? 'sm:flex-row-reverse' : ''} gap-8 sm:gap-0`}>
          
          <!-- Terminal Square Node - Absolute right angles -->
