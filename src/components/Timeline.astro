            <span class="w-1.5 h-1.5 bg-zinc-800 group-hover:bg-accent-terminal"></span>
          </div>

          <!-- Brutalist Content Card block -->
          <div class="w-full sm:w-[45%] pl-12 sm:pl-0">
            <div class={`relative bg-black border border-border-console p-6 hover:border-zinc-500 transition-all ${isEven ? 'sm:text-right' : 'sm:text-left'}`}>
              
