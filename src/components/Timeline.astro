<div class="relative max-w-4xl mx-auto py-8">
  <!-- Solid 1px Exposed Steel Grid Line -->
  <div class="absolute left-4 sm:left-1/2 top-0 bottom-0 w-px bg-border-console transform -translate-x-1/2 z-0"></div>

  <div class="space-y-12 relative z-10">
