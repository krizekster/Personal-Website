---
const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-bg-obsidian border-t border-border-console pt-12 pb-6 relative z-20">
  <div class="px-6">
    
    <!-- Brutalist Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 border-b border-border-console mb-8">
      
      <!-- Col 01 // Identity -->
      <div class="p-6 border-b lg:border-b-0 border-r border-border-console last:border-r-0 space-y-3 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono font-bold tracking-widest text-accent-terminal block">// CORE_ARCHIVE</span>
          <p class="text-xs text-zinc-400 font-sans mt-3 leading-relaxed">
            The personal root console and digital garden of Krishna Soni (Krizekster). CS Engineer, systems orchestrator, and polyglot developer.
          </p>
        </div>
        <!-- Companion Bunny telemetry -->
        <div class="border border-border-console p-3 bg-black/40 flex items-center gap-3">
          <span class="text-lg select-none">🐇</span>
          <div class="flex flex-col font-mono text-[9px]">
            <span class="text-zinc-600 tracking-wider">COMPANION // NENII_BABUU</span>
            <span class="text-zinc-300 font-bold uppercase">Operations: Active // Vegetarian</span>
          </div>
        </div>
      </div>

      <!-- Col 02 // Corporate Track -->
      <div class="p-6 border-b lg:border-b-0 border-r border-border-console last:border-r-0 space-y-4">
        <span class="text-[10px] font-mono font-bold tracking-widest text-white block">// CORPORATE_VENTURES</span>
        <ul class="space-y-3 font-mono text-[11px] text-zinc-400">
          <li>
            <a href="/ventures#krizek" class="hover:text-accent-terminal transition-colors flex items-center gap-2">
              <span>[01]</span>
              <span>KRI ZEK LLC (USA)</span>
            </a>
          </li>
          <li>
            <a href="/ventures#krizek" class="hover:text-accent-terminal transition-colors flex items-center gap-2">
              <span>[02]</span>
              <span>KRI ZEK INDIA PVT. LTD.</span>
            </a>
          </li>
          <li>
            <a href="https://krizek.com" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-white transition-colors flex items-center gap-1">
              <span>-> krizek.com</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 03 // Consumer Track -->
      <div class="p-6 border-b md:border-b-0 border-r border-border-console last:border-r-0 space-y-4">
        <span class="text-[10px] font-mono font-bold tracking-widest text-white block">// CONSUMER_PRODUCTS</span>
        <ul class="space-y-3 font-mono text-[11px] text-zinc-400">
          <li>
            <a href="/ventures#altered-brilliance" class="hover:text-accent-terminal transition-colors flex items-center gap-2">
              <span>[01]</span>
              <span>Altered Brilliance</span>
            </a>
          </li>
          <li>
            <span class="text-zinc-500 flex items-center gap-2">
              <span>[02]</span>
              <span>Mobile Infrastructure</span>
            </span>
          </li>
          <li>
            <a href="https://alteredbrilliance.com" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-white transition-colors flex items-center gap-1">
              <span>-> alteredbrilliance.com</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 04 // Systems Partnerships -->
      <div class="p-6 border-r border-border-console last:border-r-0 space-y-4">
        <span class="text-[10px] font-mono font-bold tracking-widest text-white block">// NETWORK_STATUS</span>
        <div class="space-y-2">
          <div class="border border-border-console px-3 py-1 text-[9px] font-mono text-zinc-500 bg-black/40">
            PARTNER_SYS // ANTHROPIC_INTEGRATOR
          </div>
          <div class="border border-border-console px-3 py-1 text-[9px] font-mono text-zinc-500 bg-black/40">
            ENGINEERING_CORE // VIBE_ACCELERATED
          </div>
          <div class="border border-border-console px-3 py-1 text-[9px] font-mono text-zinc-500 bg-black/40">
            COMPILE_FLOW // ZERO_JS_RENDER
          </div>
        </div>
      </div>
      
    </div>

    <!-- Telemetry Output and Network Sync links -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-[9px] font-mono text-zinc-600">
      <div>
        <span>© {currentYear} KRISHNA SONI. SYSTEM ROOT VERSION 5.0-CHRONO. ALL RIGHTS RESERVED.</span>
      </div>
      
      <!-- Network Interconnects -->
      <div class="flex gap-4">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-accent-terminal transition-colors">GITHUB_NODE</a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-accent-terminal transition-colors">TWITTER_PIPE</a>
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-accent-terminal transition-colors">LINKEDIN_CORE</a>
        <span class="text-zinc-800">// SHA-256 SYNC</span>
      </div>
    </div>
  </div>
</footer>
