---
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Research', href: '/research/' },
  { label: 'Ventures', href: '/ventures/' },
  { label: 'Writing', href: '/feed/' },
  { label: 'Book', href: '/the-power-of-gaming/' },
];

const socialLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/krizekster/' },
  { label: 'Kri Zek', href: 'https://www.krizek.tech/' },
  { label: 'GitHub', href: 'https://github.com/krizekster' },
  { label: 'Instagram', href: 'https://www.instagram.com/krizekster/' },
  { label: 'Happenstance', href: 'https://happenstance.ai/u/krizekster' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<div id="nav-drawer" class="nav-drawer-root" aria-hidden="true" inert>
  <!-- Backdrop Overlay -->
  <div class="drawer-backdrop" data-drawer-close aria-hidden="true"></div>

  <!-- Main Slide-in Panel -->
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
    <!-- Dynamic SVG Elastic Edge Curve -->
    <svg class="drawer-svg-curve" viewBox="0 0 100 800" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path id="drawer-curve-path" d="M100,0 Q100,400 100,800 L100,800 L100,0 Z" fill="#1c1d20"></path>
    </svg>

    <!-- Close Button inside Panel -->
    <button
      type="button"
      class="drawer-close-btn"
      data-drawer-close
      data-magnetic
      data-magnetic-strength="0.4"
      aria-label="Close menu"
    >
      <span class="magnetic-text">✕</span>
    </button>

    <div class="drawer-content flex h-full flex-col justify-between p-8 sm:p-14">
      <div>
        <p id="drawer-title" class="drawer-header-title font-mono text-[.68rem] uppercase tracking-[.14em] text-mist">
          Navigation
        </p>
        <hr class="mt-3 border-paper/15" />

        <!-- Staggered Large Links -->
        <nav class="mt-8 flex flex-col gap-4 sm:gap-6" aria-label="Overlay menu navigation">
          {navItems.map((item, idx) => {
            const active = isActive(item.href);
            return (
              <div class="drawer-nav-item" style={`--item-index: ${idx};`}>
                <a
                  href={item.href}
                  class={`group inline-flex items-center gap-3 text-[clamp(2.4rem,5.5vw,4.2rem)] font-extrabold tracking-[-.06em] transition-colors duration-200 ${
                    active ? 'text-paper' : 'text-paper/60 hover:text-paper'
                  }`}
                  aria-current={active ? 'page' : undefined}
                  data-page-transition
                  data-transition-label={item.label}
                  data-magnetic
                  data-magnetic-strength="0.25"
                >
                  <span class={`active-route-dot h-3 w-3 rounded-full bg-sage transition-all duration-300 ${active ? 'opacity-100 scale-100' : 'opacity-0 scale-50 group-hover:opacity-60 group-hover:scale-75'}`}></span>
                  <span class="magnetic-text">{item.label}</span>
                </a>
              </div>
            );
          })}
        </nav>
      </div>

      <!-- Socials Footer -->
      <div class="drawer-footer pt-8">
        <p class="font-mono text-[.64rem] uppercase tracking-[.14em] text-mist">
          Socials &amp; Entities
        </p>
        <div class="mt-3 flex flex-wrap gap-4 font-mono text-xs text-mist">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-paper underline underline-offset-4"
              data-magnetic
              data-magnetic-strength="0.2"
            >
              <span class="magnetic-text">{social.label} ↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
