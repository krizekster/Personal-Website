---
---

<!-- Floating Cookie Preferences Banner / Modal -->
<div 
  id="cookie-modal-root" 
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-[9990] max-w-md w-[calc(100vw-2rem)] opacity-0 pointer-events-none translate-y-6 transition-all duration-500 ease-out"
  aria-live="polite"
  role="dialog"
  aria-labelledby="cookie-modal-title"
  aria-describedby="cookie-modal-desc"
>
  <div class="relative overflow-hidden rounded-3xl border border-line bg-paper/95 p-5 sm:p-6 shadow-2xl backdrop-blur-md text-ink">
    <!-- Header with Cookie Icon & Close Button -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-ink text-paper shadow-sm">
          <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
            <path d="M21.598 11.064a1.006 1.006 0 0 0-.854-.172A3.99 3.99 0 0 1 15.5 7.001c0-.68.17-1.32.464-1.888a1 1 0 0 0-.66-1.423A10.002 10.002 0 1 0 22 12a9.92 9.92 0 0 0-.402-2.936 1.002 1.002 0 0 0-.002-.002zM12 20a8 8 0 1 1 8-8c0 .245-.015.486-.043.723a5.992 5.992 0 0 0-4.457 4.457A8.026 8.026 0 0 1 12 20zm-3.5-9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm-2 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zm7.5 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
          </svg>
        </div>
        <div>
          <span class="font-mono text-[0.65rem] uppercase tracking-wider text-ink-soft">Privacy &amp; Cookies</span>
          <h2 id="cookie-modal-title" class="text-base font-bold tracking-tight text-ink">Cookie Settings</h2>
        </div>
      </div>
      <button 
        type="button" 
        id="cookie-close-btn" 
        class="rounded-full p-1.5 text-ink-soft hover:bg-mist hover:text-ink transition-colors cursor-pointer"
        aria-label="Dismiss cookie notice"
      >
        <svg class="h-4 w-4 stroke-current fill-none stroke-2" viewBox="0 0 24 24">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Description -->
    <p id="cookie-modal-desc" class="mt-3 text-xs leading-relaxed text-ink-soft">
      We use cookies to optimize site performance, analyze traffic, and enhance user experience. You can choose your preferences below.
    </p>

    <!-- Granular Preferences (Collapsible) -->
    <div id="cookie-details" class="hidden mt-4 space-y-3 border-t border-line pt-3">
      <!-- Essential -->
      <div class="flex items-center justify-between gap-3 text-xs">
        <div>
          <span class="font-semibold text-ink">Essential</span>
          <p class="text-[0.7rem] text-ink-soft">Necessary for core site functionality &amp; security.</p>
        </div>
        <span class="font-mono text-[0.62rem] uppercase font-bold text-sage-deep bg-mist px-2 py-0.5 rounded-full shrink-0">Required</span>
      </div>

      <!-- Analytics -->
      <div class="flex items-center justify-between gap-3 text-xs">
        <div>
          <span class="font-semibold text-ink">Analytics</span>
          <p class="text-[0.7rem] text-ink-soft">Helps us measure site traffic &amp; usage patterns.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0">
          <input type="checkbox" id="cookie-analytics" class="sr-only peer" checked />
          <div class="w-8 h-4.5 bg-mist peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-ink"></div>
        </label>
      </div>

      <!-- Experience / Preferences -->
      <div class="flex items-center justify-between gap-3 text-xs">
        <div>
          <span class="font-semibold text-ink">Preferences</span>
          <p class="text-[0.7rem] text-ink-soft">Saves your customized site &amp; layout preferences.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer shrink-0">
          <input type="checkbox" id="cookie-preferences" class="sr-only peer" checked />
          <div class="w-8 h-4.5 bg-mist peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-3.5 after:w-3.5 after:transition-all peer-checked:bg-ink"></div>
        </label>
      </div>
    </div>

    <!-- Actions -->
    <div class="mt-4 flex flex-wrap items-center justify-between gap-2 pt-1">
      <button 
        type="button" 
        id="cookie-toggle-details-btn" 
        class="text-xs font-semibold text-ink-soft hover:text-ink underline underline-offset-4 transition-colors cursor-pointer"
      >
        Customize
      </button>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="cookie-essential-btn" 
          class="pill border-line bg-paper text-ink hover:bg-paper-deep transition-colors text-xs py-1.5 px-3 cursor-pointer"
        >
          Essential Only
        </button>
        <button 
          type="button" 
          id="cookie-accept-btn" 
          class="pill border-ink bg-ink text-paper hover:bg-sage-deep transition-colors text-xs py-1.5 px-4 font-bold cursor-pointer"
        >
          Accept All
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'site_cookie_consent_v1';

  interface CookieConsent {
    essential: boolean;
    analytics: boolean;
    preferences: boolean;
    timestamp: string;
  }

  function initCookieModal() {
    const modal = document.getElementById('cookie-modal-root');
    const closeBtn = document.getElementById('cookie-close-btn');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const essentialBtn = document.getElementById('cookie-essential-btn');
    const toggleDetailsBtn = document.getElementById('cookie-toggle-details-btn');
    const detailsContainer = document.getElementById('cookie-details');
    const analyticsCheckbox = document.getElementById('cookie-analytics') as HTMLInputElement | null;
    const preferencesCheckbox = document.getElementById('cookie-preferences') as HTMLInputElement | null;

    if (!modal) return;

    let isDetailsExpanded = false;

    function showModal() {
      modal?.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-6');
      modal?.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
    }

    function hideModal() {
      modal?.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      modal?.classList.add('opacity-0', 'pointer-events-none', 'translate-y-6');
    }

    function saveConsent(analytics: boolean, preferences: boolean) {
      const consent: CookieConsent = {
        essential: true,
        analytics,
        preferences,
        timestamp: new Date().toISOString()
      };

      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(consent));
      } catch (e) {
        console.warn('Unable to save cookie consent to localStorage', e);
      }

      window.dispatchEvent(new CustomEvent('cookieConsentUpdated', { detail: consent }));
      hideModal();
    }

    // Toggle detailed preference toggles
    toggleDetailsBtn?.addEventListener('click', () => {
      isDetailsExpanded = !isDetailsExpanded;
      if (isDetailsExpanded) {
        detailsContainer?.classList.remove('hidden');
        toggleDetailsBtn.textContent = 'Hide Options';
      } else {
        detailsContainer?.classList.add('hidden');
        toggleDetailsBtn.textContent = 'Customize';
      }
    });

    // Accept All button
    acceptBtn?.addEventListener('click', () => {
      if (isDetailsExpanded) {
        // Save current checkbox choices if details panel is open
        const analyticsVal = analyticsCheckbox ? analyticsCheckbox.checked : true;
        const prefVal = preferencesCheckbox ? preferencesCheckbox.checked : true;
        saveConsent(analyticsVal, prefVal);
      } else {
        saveConsent(true, true);
      }
    });

    // Essential Only button
    essentialBtn?.addEventListener('click', () => {
      saveConsent(false, false);
    });

    // Close button (treats as essential only)
    closeBtn?.addEventListener('click', () => {
      saveConsent(false, false);
    });

    // Event listener to re-open modal from anywhere (e.g. Footer link)
    window.addEventListener('openCookieModal', () => {
      // Pre-fill checkboxes based on saved consent if available
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed: CookieConsent = JSON.parse(saved);
          if (analyticsCheckbox) analyticsCheckbox.checked = !!parsed.analytics;
          if (preferencesCheckbox) preferencesCheckbox.checked = !!parsed.preferences;
        }
      } catch (e) {}

      // Auto expand options on manual reopen so user can change preferences easily
      isDetailsExpanded = true;
      detailsContainer?.classList.remove('hidden');
      if (toggleDetailsBtn) toggleDetailsBtn.textContent = 'Hide Options';

      showModal();
    });

    function scheduleInitialModalDisplay() {
      const loaderEl = document.getElementById('landing-loader');
      const isLoaderActive = document.documentElement.classList.contains('landing-is-loading') || !!loaderEl;

      if (isLoaderActive) {
        let shown = false;
        const triggerShow = () => {
          if (shown) return;
          shown = true;
          window.removeEventListener('landingLoaderComplete', triggerShow);
          // Wait 600ms after preloader lifts away so landing hero reveals smoothly first
          setTimeout(() => {
            showModal();
          }, 600);
        };

        window.addEventListener('landingLoaderComplete', triggerShow);

        // Fallback safety check in case event is missed or preloader removed
        const checkInterval = setInterval(() => {
          const stillLoading = document.documentElement.classList.contains('landing-is-loading') || !!document.getElementById('landing-loader');
          if (!stillLoading) {
            clearInterval(checkInterval);
            triggerShow();
          }
        }, 300);
      } else {
        // No preloader active on this route
        setTimeout(() => {
          showModal();
        }, 800);
      }
    }

    // Check if consent has already been saved
    try {
      const savedConsent = localStorage.getItem(STORAGE_KEY);
      if (!savedConsent) {
        scheduleInitialModalDisplay();
      }
    } catch (e) {
      scheduleInitialModalDisplay();
    }
  }

  // Support both standard DOMContentLoaded and Astro view transitions page loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieModal);
  } else {
    initCookieModal();
  }

  document.addEventListener('astro:page-load', initCookieModal);
</script>
