---
interface Props {
  title?: string;
  subtitle?: string;
  tag?: string;
  accent?: 'blue' | 'green' | 'steel';
  hoverGlow?: boolean;
}

const { title, subtitle, tag, accent = 'steel' } = Astro.props;
const tones = {
  blue: 'bg-[#d9e4e3]',
  green: 'bg-[#dce5cf]',
  steel: 'bg-[#e9e8df]',
};
const hasFooter = Astro.slots.has('footer');
---

<article class={`surface-card flex h-full flex-col transition-transform duration-300 hover:-translate-y-1 ${tones[accent]}`}>
  <div class="flex items-start justify-between gap-4 border-b border-line pb-4">
    {tag && <span class="eyebrow">{tag}</span>}
    {subtitle && <span class="text-right font-mono text-[.63rem] uppercase tracking-[.06em] text-ink-soft">{subtitle}</span>}
  </div>
  {title && <h3 class="mt-7 text-[clamp(1.45rem,3vw,2.3rem)] font-bold leading-[.94] tracking-[-.065em]">{title}</h3>}
  <div class="mt-5 flex-1 text-sm leading-relaxed text-ink-soft"><slot /></div>
  {hasFooter && <footer class="mt-7 border-t border-line pt-4"><slot name="footer" /></footer>}
</article>
