<div id="landing-loader" class="landing-loader" aria-hidden="true" hidden>
  <span id="loader-greeting" class="landing-loader__word is-visible" lang="hi">नमस्ते</span>
</div>

<script is:inline>
const loader = document.getElementById('landing-loader');
const greeting = document.getElementById('loader-greeting');
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const loaderSkipKey = 'krize-kster-skip-next-home-loader';
const loaderSeenKey = 'krize-kster-home-loader-seen';
const loaderSkipMarker = '__krize_kster_skip_next_home_loader__';
let shouldSkipLoader = false;

try {
  shouldSkipLoader = window.sessionStorage.getItem(loaderSkipKey) === 'true'
    || window.sessionStorage.getItem(loaderSeenKey) === 'true';
} catch {
  // Fall back to window.name when browser storage is unavailable.
}

if (!shouldSkipLoader) {
  try {
    shouldSkipLoader = window.name.includes(loaderSkipMarker);
  } catch {
    // The loader still runs if neither persistence mechanism is available.
  }
}

if (loader && greeting) {
  try {
    window.sessionStorage.setItem(loaderSeenKey, 'true');
  } catch {
    // The loader remains functional when browser storage is unavailable.
  }

  if (shouldSkipLoader) {
    try {
      window.sessionStorage.removeItem(loaderSkipKey);
    } catch {
      // Clear the window.name fallback below when needed.
    }
    try {
      window.name = window.name.replace(loaderSkipMarker, '');
    } catch {
      // No persistence cleanup is needed when window.name is unavailable.
    }
  }

  if (reduceMotion || shouldSkipLoader) {
    loader.remove();
    window.dispatchEvent(new CustomEvent('landingLoaderComplete'));
  } else {
      loader.hidden = false;
      const greetings = [
        { text: 'नमस्ते', lang: 'hi' },
        { text: 'Hola', lang: 'es' },
        { text: 'Bonjour', lang: 'fr' },
        { text: 'Ciao', lang: 'it' },
        { text: 'Hallo', lang: 'de' },
        { text: 'Olá', lang: 'pt' },
        { text: 'Hej', lang: 'sv' },
        { text: 'Merhaba', lang: 'tr' },
        { text: '你好', lang: 'zh' },
        { text: '안녕하세요', lang: 'ko' },
        { text: 'สวัสดี', lang: 'th' },
        { text: 'こんにちは', lang: 'ja' },
      ];
      // Keep the greeting sequence snappy while preserving a clear visual beat.
      const wordDuration = 250;
      const exitDuration = 700;
      const greetingDuration = greetings.length * wordDuration;
      let dismissed = false;

      document.documentElement.classList.add('landing-is-loading');

      const setGreeting = (item) => {
        greeting.classList.remove('is-visible');
        window.setTimeout(() => {
          greeting.textContent = item.text;
          greeting.lang = item.lang;
          greeting.classList.add('is-visible');
        }, 42);
      };

      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        loader.classList.add('is-leaving');
        // Keep the page hidden until the greeting screen has completely
        // lifted. This prevents the landing-page fade from competing with
        // the final language in the sequence.
        window.setTimeout(() => {
          loader.remove();
          window.requestAnimationFrame(() => {
            document.documentElement.classList.remove('landing-is-loading');
            window.dispatchEvent(new CustomEvent('landingLoaderComplete'));
          });
        }, exitDuration + 20);
      };

      greetings.slice(1).forEach((item, index) => {
        window.setTimeout(() => setGreeting(item), (index + 1) * wordDuration);
      });

      window.setTimeout(dismiss, greetingDuration);
    }
  }
</script>
